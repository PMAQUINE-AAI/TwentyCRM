# TwentyCRM — déploiement « solopreneur » (mono-utilisateur, auto-hébergé)
#
# Copiez ce fichier en `.env` puis remplissez les valeurs marquées CHANGE_ME.
#   cp .env.example .env
#
# Génération des secrets :
#   openssl rand -base64 32

# --- Version de l'image (pinnée, jamais `latest`) --------------------------
# ⚠️ `latest` peut sauter plusieurs versions majeures lors d'un simple
#    `docker compose pull` et exécuter des migrations DB irréversibles.
#    Versions : https://github.com/twentyhq/twenty/releases
#    Mise à jour : sauvegarder, incrémenter TAG, `docker compose up -d`.
TAG=v2.22.1

# --- URL publique de l'instance -------------------------------------------
# En local : http://localhost:3000
# Derrière un reverse-proxy + HTTPS : https://crm.mondomaine.com
SERVER_URL=http://localhost:3000

# --- Exposition réseau ------------------------------------------------------
# Par défaut le port 3000 n'est accessible qu'en local (127.0.0.1) : pas de
# login/mot de passe en HTTP clair sur internet.
# - HTTPS avec un domaine : laisser 127.0.0.1 et utiliser le profil caddy
#     CADDY_DOMAIN=crm.mondomaine.com  +  docker compose --profile proxy up -d
# - Accès direct par IP (http://IP:3000, déconseillé hors test) :
#     BIND_IP=0.0.0.0
# BIND_IP=127.0.0.1
# CADDY_DOMAIN=crm.mondomaine.com

# --- PostgreSQL ------------------------------------------------------------
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=CHANGE_ME_strong_password_no_special_chars
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://redis:6379

# --- Secrets (OBLIGATOIRE) -------------------------------------------------
# ⚠️ Perdre ENCRYPTION_KEY = perdre l'accès à tous les secrets chiffrés
#    (tokens OAuth, config). Sauvegardez-la hors du serveur.
ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_32
# FALLBACK_ENCRYPTION_KEY=   # uniquement pendant une rotation de clé

# --- Stockage fichiers : local (pas de S3 nécessaire) ----------------------
STORAGE_TYPE=local

# --- Profil SOLO : mono-workspace, sans billing, auth par mot de passe -----
IS_MULTIWORKSPACE_ENABLED=false
IS_BILLING_ENABLED=false
AUTH_PASSWORD_ENABLED=true
IS_EMAIL_VERIFICATION_REQUIRED=false
# Seul un admin serveur peut créer un workspace (le 1er reste autorisé) :
IS_WORKSPACE_CREATION_LIMITED_TO_SERVER_ADMINS=true

# --- Emails transactionnels ------------------------------------------------
# Par défaut "logger" (les emails s'affichent dans les logs, aucun envoi réel).
# Pour de vrais emails (reset mot de passe, invitations), décommentez SMTP :
# EMAIL_DRIVER=smtp
# EMAIL_FROM_ADDRESS=contact@mondomaine.com
# EMAIL_FROM_NAME=Mon CRM
# EMAIL_SMTP_HOST=smtp.exemple.com
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=

# --- Sync mail/agenda perso (optionnel, IMAP/CalDAV, pas d'OAuth requis) ---
# IS_IMAP_SMTP_CALDAV_ENABLED=true   # déjà activé par défaut
